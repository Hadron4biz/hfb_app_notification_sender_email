<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hfb_app_notification_sender_email.MessageNotificationPopoverEmail"
       t-inherit="mail.MessageNotificationPopover"
       t-inherit-mode="extension">
        <!-- res_partner_id is a relational reference to the shared, live
             res.partner record - we don't touch it. Instead we prefer our
             frozen x_sent_to_email over its live .email wherever the native
             template already renders the partner's address. -->
        <xpath expr="//div[@t-foreach='otherNotifications']//t[@t-out='notification.res_partner_id.email']"
               position="attributes">
            <attribute name="t-out">notification.x_sent_to_email or notification.res_partner_id.email</attribute>
        </xpath>
        <xpath expr="//div[@t-foreach='followerNotifications']//t[@t-out='notification.res_partner_id.email']"
               position="attributes">
            <attribute name="t-out">notification.x_sent_to_email or notification.res_partner_id.email</attribute>
        </xpath>
    </t>

</templates>
