<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hfb_app_notification_sender_email.MessageNotificationPopoverEmail"
       t-inherit="mail.MessageNotificationPopover"
       t-inherit-mode="extension">
        <xpath expr="//span[@t-if='notification.persona']" position="after">
            <span t-if="notification.x_sent_to_email"
                  class="text-muted ms-1"
                  t-esc="'(' + notification.x_sent_to_email + ')'"/>
        </xpath>
        <xpath expr="//div[@t-foreach='props.message.notifications']" position="before">
            <div class="text-muted small mb-1" t-esc="props.message.datetimeShort"/>
        </xpath>
    </t>

</templates>
